# Nusxa oling: cp .env.example .env
# SECRET_KEY bo'sh qolsa, birinchi ishga tushishda avtomatik yaratilib .env ga yoziladi.
# SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://crm.example.uz
TIME_ZONE=Asia/Tashkent
# SQLITE_PATH=/var/data/db.sqlite3

# Avtomatik superuser (python manage.py ensure_superuser)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=
